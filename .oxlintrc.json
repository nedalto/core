{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": { "typeAware": true },
  "env": { "node": true },
  "rules": {
    "no-console": "warn",
    "typescript/ban-ts-comment": "error",
    "typescript/no-floating-promises": [
      "error",
      { "allowForKnownSafeCalls": [{ "from": "package", "package": "node:test", "name": ["describe", "test"] }] }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-deprecated": "warn",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }]
  },
  "overrides": [
    {
      "files": ["packages/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@nedalto/**", "!@nedalto/contract/**"],
                "message": "Packages may only import @nedalto/contract subpaths; apps/hub composes them."
              },
              {
                "group": ["@matter/**"],
                "message": "Only packages/matter talks to the Matter SDK."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/matter/**/*.ts"],
      "rules": {
        "import/no-unassigned-import": ["error", { "allow": ["**/sdk-config.ts"] }],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@nedalto/**", "!@nedalto/contract/**"],
                "message": "Packages may only import @nedalto/contract subpaths; apps/hub composes them."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/server/src/**/*.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          { "object": "JSON", "property": "stringify", "message": "Use encode from @nedalto/contract/common/wire.ts." },
          { "object": "JSON", "property": "parse", "message": "Use decode from @nedalto/contract/common/wire.ts." }
        ]
      }
    },
    {
      "files": ["packages/database/src/rows.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["packages/contract/src/common/ids.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
