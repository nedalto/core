{
  "name": "nedalto",
  "private": true,
  "license": "EUPL-1.2",
  "author": "Alejandro Ojeda Gutiérrez",
  "repository": {
    "type": "git",
    "url": "https://github.com/nedalto/core.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.20.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "error"
    }
  }
}
