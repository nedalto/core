      "format_on_save": "on"
    },
    "Markdown": {
      "formatter": { "language_server": { "name": "oxfmt" } },
      "format_on_save": "on"
    },
    "TypeScript": {
      "language_servers": ["!vtsls", "!typescript-language-server", "!eslint", "!tailwindcss-language-server", "..."],
      "code_actions_on_format": { "source.fixAll.oxc": true },
